{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EndpointDesc": {
      "oneOf": [
        {
          "properties": {
            "ip_address": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "protocol": {
              "type": "string"
            },
            "is_stun_discovered": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "ip_address",
            "port"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "PeerAttestation": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "os_name": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "client_version": {
          "type": "string"
        },
        "country_code": {
          "type": "string"
        },
        "asn": {
          "type": "integer"
        },
        "disk_encrypted": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "firewall_active": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_rootless": {
          "type": "boolean"
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "os_name",
        "os_version",
        "client_version",
        "country_code",
        "asn",
        "disk_encrypted",
        "firewall_active",
        "is_rootless",
        "timestamp_utc"
      ]
    },
    "PeerPathObservation": {
      "properties": {
        "peer_id": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "relay_id": {
          "type": "string"
        },
        "last_handshake_unix": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "wg_rx_bytes": {
          "type": "integer"
        },
        "wg_tx_bytes": {
          "type": "integer"
        },
        "observed_at_unix": {
          "type": "integer"
        },
        "state": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rtt_ms": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "peer_id",
        "last_handshake_unix",
        "wg_rx_bytes",
        "wg_tx_bytes",
        "observed_at_unix",
        "state",
        "rtt_ms"
      ]
    },
    "RelayHome": {
      "properties": {
        "relay_id": {
          "type": "string"
        },
        "observed_at_unix": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "relay_id",
        "observed_at_unix"
      ]
    }
  },
  "$comment": "DO NOT EDIT. Generated by 'go run ./cmd/contractgen' from Go struct tags in pkg/control/types.go.",
  "properties": {
    "node_id": {
      "type": "string"
    },
    "sequence_num": {
      "type": "integer"
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/EndpointDesc"
      },
      "type": "array"
    },
    "active_circuits": {
      "type": "integer"
    },
    "tx_bytes_sec": {
      "type": "integer"
    },
    "rx_bytes_sec": {
      "type": "integer"
    },
    "cpu_usage_pct": {
      "type": "integer"
    },
    "memory_usage_mb": {
      "type": "integer"
    },
    "battery_level_pct": {
      "type": "integer"
    },
    "on_battery_power": {
      "type": "boolean"
    },
    "rtt_ms": {
      "type": "integer"
    },
    "posture": {
      "$ref": "#/$defs/PeerAttestation"
    },
    "transport_report_version": {
      "type": "string"
    },
    "relay_homes": {
      "items": {
        "$ref": "#/$defs/RelayHome"
      },
      "type": "array"
    },
    "peer_paths": {
      "items": {
        "$ref": "#/$defs/PeerPathObservation"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "node_id"
  ]
}
