{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CompiledFilterRule": {
      "properties": {
        "allowed_peer_vip": {
          "type": "string",
          "format": "ipv4"
        },
        "protocol": {
          "type": "string"
        },
        "port_ranges": {
          "items": {
            "$ref": "#/$defs/PortRange"
          },
          "type": "array"
        },
        "action": {
          "type": "string"
        },
        "is_directional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "allowed_peer_vip",
        "protocol",
        "port_ranges",
        "action",
        "is_directional"
      ]
    },
    "CompiledPeerPolicy": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "overlay_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "inbound_rules": {
          "items": {
            "$ref": "#/$defs/CompiledFilterRule"
          },
          "type": "array"
        },
        "outbound_rules": {
          "items": {
            "$ref": "#/$defs/CompiledFilterRule"
          },
          "type": "array"
        },
        "epoch": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "overlay_ipv4",
        "inbound_rules",
        "outbound_rules",
        "epoch"
      ]
    },
    "IPMask": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "IPNet": {
      "properties": {
        "IP": {
          "type": "string",
          "format": "ipv4"
        },
        "Mask": {
          "$ref": "#/$defs/IPMask"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "IP",
        "Mask"
      ]
    },
    "NetmapPeer": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "public_key_hex": {
          "type": "string"
        },
        "allowed_ips": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "endpoints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "derp_region": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "keepalive_seconds": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "public_key_hex",
        "allowed_ips",
        "endpoints",
        "derp_region",
        "keepalive_seconds"
      ]
    },
    "NetmapSelf": {
      "properties": {
        "overlay_ipv4": {
          "type": "string"
        },
        "overlay_ipv6": {
          "type": "string"
        },
        "mtu": {
          "type": "integer"
        },
        "listen_port": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "overlay_ipv4",
        "overlay_ipv6",
        "mtu",
        "listen_port"
      ]
    },
    "NetworkRoute": {
      "properties": {
        "id": {
          "type": "string"
        },
        "network_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "network_cidr": {
          "$ref": "#/$defs/IPNet"
        },
        "masquerade": {
          "type": "boolean"
        },
        "failover_mode": {
          "type": "string"
        },
        "routing_peers": {
          "items": {
            "$ref": "#/$defs/RoutingPeerSpec"
          },
          "type": "array"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "network_id",
        "description",
        "network_cidr",
        "masquerade",
        "failover_mode",
        "routing_peers",
        "groups",
        "enabled",
        "created_at",
        "updated_at"
      ]
    },
    "PortRange": {
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    },
    "RoutingPeerSpec": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "is_healthy": {
          "type": "boolean"
        },
        "last_probe_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_rtt_ms": {
          "type": "number"
        },
        "fail_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "priority",
        "is_healthy",
        "last_probe_at",
        "latency_rtt_ms",
        "fail_count"
      ]
    }
  },
  "$comment": "DO NOT EDIT. Generated by 'go run ./cmd/contractgen' from Go struct tags in pkg/control/types.go.",
  "properties": {
    "version": {
      "type": "integer"
    },
    "unchanged": {
      "type": "boolean"
    },
    "self": {
      "$ref": "#/$defs/NetmapSelf"
    },
    "peers": {
      "items": {
        "$ref": "#/$defs/NetmapPeer"
      },
      "type": "array"
    },
    "acl": {
      "$ref": "#/$defs/CompiledPeerPolicy"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/NetworkRoute"
      },
      "type": "array"
    },
    "revoked_keys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at_unix": {
      "type": "integer"
    },
    "max_staleness_seconds": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "unchanged"
  ]
}
