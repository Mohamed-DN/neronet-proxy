{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CompiledFilterRule": {
      "properties": {
        "allowed_peer_vip": {
          "type": "string",
          "format": "ipv4"
        },
        "protocol": {
          "type": "string"
        },
        "port_ranges": {
          "items": {
            "$ref": "#/$defs/PortRange"
          },
          "type": "array"
        },
        "action": {
          "type": "string"
        },
        "is_directional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "allowed_peer_vip",
        "protocol",
        "port_ranges",
        "action",
        "is_directional"
      ]
    },
    "CompiledPeerPolicy": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "overlay_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "inbound_rules": {
          "items": {
            "$ref": "#/$defs/CompiledFilterRule"
          },
          "type": "array"
        },
        "outbound_rules": {
          "items": {
            "$ref": "#/$defs/CompiledFilterRule"
          },
          "type": "array"
        },
        "epoch": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "overlay_ipv4",
        "inbound_rules",
        "outbound_rules",
        "epoch"
      ]
    },
    "PortRange": {
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "start",
        "end"
      ]
    }
  },
  "$comment": "DO NOT EDIT. Generated by 'go run ./cmd/contractgen' from Go struct tags in pkg/control/types.go.",
  "properties": {
    "new_policy_epoch": {
      "type": "integer"
    },
    "policy": {
      "oneOf": [
        {
          "$ref": "#/$defs/CompiledPeerPolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "new_policy_epoch",
    "policy"
  ]
}
