# =================================================================
# NeroNet Sovereign Proxy & Enterprise Console Environment Template
# =================================================================

# Server Network Configuration
NODE_ENV=development
SOVEREIGN_API_HOST=127.0.0.1
SOVEREIGN_API_PORT=8082

# Embedded SQLite Database Configuration
SOVEREIGN_DB_PATH=./data/neronet.db

# JWT & Authentication Secrets
#
# Left blank on purpose. An example file that ships working secret values is the
# shortest path to deploying with a credential that is published in this repository,
# and a presence check cannot tell the difference. Under NODE_ENV=production the API
# rejects both an unset value and any value that has ever appeared in a committed
# file here.
#
# Generate a distinct value for each:
#   openssl rand -base64 48
SOVEREIGN_JWT_SECRET=
SOVEREIGN_JWT_EXPIRES_IN=15m
SOVEREIGN_REFRESH_SECRET=
SOVEREIGN_REFRESH_EXPIRES_IN=7d

# Initial Super-Admin Provisioning
SOVEREIGN_ADMIN_USER=admin
SOVEREIGN_ADMIN_PASS=
SOVEREIGN_ADMIN_EMAIL=admin@example.com

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://127.0.0.1:8081,http://localhost:8081,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# Mesh Relay & Master Server Public Key Configuration
SOVEREIGN_SERVER_ENDPOINT=relay-us.example.com:51820
SOVEREIGN_SERVER_PUBKEY=
SOVEREIGN_CONTROL_PLANE_URL=https://mesh.example.com/v4/control

# PostgreSQL password, required when DATABASE_URL or DB_TYPE=postgres is used
POSTGRES_PASSWORD=
