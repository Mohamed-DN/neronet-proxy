{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "IPMask": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "IPNet": {
      "properties": {
        "IP": {
          "type": "string",
          "format": "ipv4"
        },
        "Mask": {
          "$ref": "#/$defs/IPMask"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "IP",
        "Mask"
      ]
    },
    "NetworkRoute": {
      "properties": {
        "id": {
          "type": "string"
        },
        "network_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "network_cidr": {
          "$ref": "#/$defs/IPNet"
        },
        "masquerade": {
          "type": "boolean"
        },
        "failover_mode": {
          "type": "string"
        },
        "routing_peers": {
          "items": {
            "$ref": "#/$defs/RoutingPeerSpec"
          },
          "type": "array"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "network_id",
        "description",
        "network_cidr",
        "masquerade",
        "failover_mode",
        "routing_peers",
        "groups",
        "enabled",
        "created_at",
        "updated_at"
      ]
    },
    "RoutingPeerSpec": {
      "properties": {
        "node_id": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "is_healthy": {
          "type": "boolean"
        },
        "last_probe_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_rtt_ms": {
          "type": "number"
        },
        "fail_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "node_id",
        "priority",
        "is_healthy",
        "last_probe_at",
        "latency_rtt_ms",
        "fail_count"
      ]
    }
  },
  "$comment": "DO NOT EDIT. Generated by 'go run ./cmd/contractgen' from Go struct tags in pkg/control/types.go.",
  "properties": {
    "new_route_epoch": {
      "type": "integer"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/NetworkRoute"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "new_route_epoch",
    "routes"
  ]
}
