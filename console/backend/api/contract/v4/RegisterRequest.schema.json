{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CapabilityDesc": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "country_code": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "asn": {
          "type": "integer"
        },
        "ip_class": {
          "type": "string"
        },
        "max_bandwidth_kbps": {
          "type": "integer"
        },
        "max_concurrent_streams": {
          "type": "integer"
        },
        "allow_udp": {
          "type": "boolean"
        },
        "ac_power_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EndpointDesc": {
      "oneOf": [
        {
          "properties": {
            "ip_address": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "protocol": {
              "type": "string"
            },
            "is_stun_discovered": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "ip_address",
            "port"
          ]
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "$comment": "DO NOT EDIT. Generated by 'go run ./cmd/contractgen' from Go struct tags in pkg/control/types.go.",
  "properties": {
    "public_key_hex": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/EndpointDesc"
      },
      "type": "array"
    },
    "auth_token": {
      "type": "string"
    },
    "client_version": {
      "type": "string"
    },
    "os_arch": {
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/CapabilityDesc"
    },
    "preauth_key": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "proof": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "public_key_hex"
  ]
}
