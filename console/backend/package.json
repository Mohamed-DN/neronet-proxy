{
  "name": "neronet-console-backend",
  "version": "4.0.0",
  "description": "NeroNet Sovereign Mesh Enterprise Management Console Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node -e 'require(\"./db/migrator\").runMigrations(require(\"./db/index\").getPgPool())'",
    "seed": "node -e 'const { getPgPool } = require(\"./db/index\"); const { runMigrations } = require(\"./db/migrator\"); const { seedDatabase } = require(\"./db/seed\"); const pool = getPgPool(); runMigrations(pool).then(() => seedDatabase(pool));'",
    "test": "SOVEREIGN_RATE_LIMIT_DISABLED=true SOVEREIGN_VALKEY_NAMESPACE=test-{pid} node --test --test-concurrency=1 tests/**/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
