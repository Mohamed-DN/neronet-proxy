# The console and the node control API, TLS only. Where the certificate comes from is
# NERONET_TLS_MODE, which tls/neronet-tls.sh turns into the files included below:
#
#   internal (default)  compose secrets console_tls_cert and console_tls_key:
#                       scripts/dev/gen-certs.sh writes a development pair, a deployment
#                       mounts its own under the same names.
#   acme                a certificate from an ACME CA, renewed by the acme service; nginx
#                       reloads when a new one is published. Port 80 then answers the
#                       CA's HTTP-01 challenges (the http01.conf include at the end of
#                       this file).
server {
    listen 8443 ssl;
    server_name localhost 127.0.0.1 frontend;

    include /etc/nginx/neronet/tls.conf;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    # Plain HTTP sent to this port: send the browser to the same address over TLS
    # rather than answer with nginx's bare 400.
    error_page 497 =301 https://$http_host$request_uri;

    root /usr/share/nginx/html;
    index index.html;

    # The resolver is whatever the container runtime put in /etc/resolv.conf: Docker's
    # 127.0.0.11, Podman's network gateway, or the cluster DNS in Kubernetes. The
    # nginx image fills NGINX_LOCAL_RESOLVERS from that file at start. A hard-coded
    # address works only on the network it was copied from; on any other subnet the
    # backend never resolves and every node request times out.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
    set $backend_upstream "backend:8081";

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        try_files $uri $uri/ /index.html;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        # Strict-Transport-Security, in acme mode only: the development certificate is for
        # localhost, and a browser would pin that name for every port.
        include /etc/nginx/neronet/hsts.conf;
    }

    location /v4/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /.well-known/ {
        proxy_pass http://$backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# Liveness for the container runtime, which has no TLS client to probe 8443 with.
# Loopback inside the container only, never published, and it serves nothing else.
server {
    listen 127.0.0.1:8090;

    location = /healthz {
        access_log off;
        # 200, or 503 in acme mode until the first certificate has been published.
        include /etc/nginx/neronet/healthz.conf;
    }

    location / {
        return 404;
    }
}

# Port 80 in acme mode: the ACME HTTP-01 challenge and a redirect to the console. Empty
# in internal mode, where nothing listens on 80.
include /etc/nginx/neronet/http01.conf;
