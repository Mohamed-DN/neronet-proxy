# Sovereign mesh binaries: node, CLI and DERP relay.
#
# Separate from docker/Dockerfile, which builds the security daemon.
# Keep the builder at the security patch level required by go.mod.
FROM golang:1.26.11 AS builder

WORKDIR /build
COPY go.mod go.sum ./
COPY third_party/amneziawg-go ./third_party/amneziawg-go
RUN go mod download

COPY internal ./internal
COPY pkg ./pkg
COPY cmd ./cmd
# The node is built with the awg tag: it carries the AmneziaWG device the profile gateway can
# run (ADR 0036). The device stays off unless SOVEREIGN_AWG_LISTEN names a port and the netmap
# carries the organisation's parameters, so the tag adds code, not behaviour.
RUN CGO_ENABLED=0 GOOS=linux go build -tags awg -ldflags="-s -w" -o /build/bin/sovereign-node ./cmd/sovereign-node \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/bin/sovereign-cli ./cmd/sovereign-cli \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/bin/sovereign-derp-relay ./cmd/sovereign-derp-relay

FROM alpine:3.20

RUN adduser -D -u 10001 neronet

# The node's identity key lives here. Creating the directory in the image, owned by
# the unprivileged user, is what makes a named volume mounted over it inherit that
# ownership: Docker copies the image's ownership onto an empty volume, and a volume
# created against a path that does not exist in the image comes up owned by root,
# where uid 10001 cannot write.
# /var/lib/neronet-drop is the NeroDrop mailbox (ADR 0033) on a gateway that runs it: its
# own volume, so the ciphertext can be sized, inspected and wiped apart from the identity.
RUN mkdir -p /var/lib/neronet /var/lib/neronet-drop  && chown 10001:10001 /var/lib/neronet /var/lib/neronet-drop  && chmod 700 /var/lib/neronet /var/lib/neronet-drop

COPY --from=builder /build/bin/sovereign-node /bin/sovereign-node
COPY --from=builder /build/bin/sovereign-cli /bin/sovereign-cli
COPY --from=builder /build/bin/sovereign-derp-relay /bin/sovereign-derp-relay

USER 10001:10001
ENTRYPOINT ["/bin/sovereign-node"]
