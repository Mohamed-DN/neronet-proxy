[Unit]
Description=NeroNet SNI router on TCP 443 (nginx stream)
Documentation=file:///usr/share/doc/neronet-gateway/README.md
After=network-online.target
ConditionPathExists=/etc/neronet-gateway/router/nginx.conf

[Service]
Type=simple
# Not enabled by the package and not started by it. `neronet-443-swap apply --yes` writes
# /etc/neronet-gateway/router/nginx.conf and starts this unit after freeing 443.
User=neronet-router
Group=neronet-router
ExecStartPre=/usr/sbin/nginx -t -c /etc/neronet-gateway/router/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/neronet-gateway/router/nginx.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=neronet-443-router
Restart=on-failure
RestartSec=2s

NoNewPrivileges=yes
# Only to bind 443.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=128M
CPUQuota=50%
CPUWeight=100
TasksMax=128
IOSchedulingClass=idle
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
