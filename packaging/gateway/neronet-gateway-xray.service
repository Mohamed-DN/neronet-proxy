[Unit]
Description=NeroNet gateway VLESS + REALITY terminator (Xray-core)
Documentation=file:///usr/share/doc/neronet-gateway/README.md
After=neronet-gateway-node.service
# Runs exactly while the node has written a configuration. The node removes the file when
# the organisation switches the method off; the path unit then restarts this service, the
# condition fails, and Xray stays stopped.
ConditionPathExists=/var/lib/neronet-gateway/xray/config.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=neronet-xray
Group=neronet-xray
# Xray never gets access to the node's state directory (mode 0700, owned by the node's user).
# Before each start, systemd runs the "+" command with full privileges and puts a private copy
# of the file in this unit's runtime directory, readable by neronet-xray only. The directory
# is removed when the unit stops.
RuntimeDirectory=neronet-gateway-xray
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/install -o neronet-xray -g neronet-xray -m 0400 /var/lib/neronet-gateway/xray/config.json /run/neronet-gateway-xray/config.json
ExecStart=/usr/lib/neronet-gateway/xray run -c /run/neronet-gateway-xray/config.json
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=512M
MemoryHigh=448M
CPUQuota=100%
CPUWeight=20
TasksMax=1024
IOSchedulingClass=idle
Nice=10
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
