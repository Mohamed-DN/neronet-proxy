[Unit]
Description=NeroNet profile gateway node
Documentation=file:///usr/share/doc/neronet-gateway/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=neronet-gw
Group=neronet-gw
# Settings the operator owns: control plane address, public port, country.
EnvironmentFile=/etc/neronet-gateway/node.env
# Settings the package owns: where Xray listens, where the node writes its configuration.
# The enrolment key, if any, is a single-use file that the node removes once it is accepted.
Environment=SOVEREIGN_DATAPLANE=netstack
Environment=SOVEREIGN_NODE_KEY_PATH=/var/lib/neronet-gateway/node_identity.key
Environment=SOVEREIGN_VLESS_SOCKS_LISTEN=127.0.0.1:1081
Environment=SOVEREIGN_VLESS_SOCKS_ADDR=127.0.0.1:1081
Environment=SOVEREIGN_XRAY_CONFIG=/var/lib/neronet-gateway/xray/config.json
Environment=SOVEREIGN_ENROLMENT_KEY_FILE=/var/lib/neronet-gateway/enrol.key
ExecStart=/usr/lib/neronet-gateway/sovereign-node
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# State: /var/lib/neronet-gateway (identity key, Xray configuration), nothing else is writable.
StateDirectory=neronet-gateway neronet-gateway/xray
StateDirectoryMode=0700
UMask=0077

# Hardening. The node needs no privilege: it listens on loopback and high ports and runs
# the mesh in userspace.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Keep the server's own services first: the node yields CPU, disk and memory.
MemoryMax=384M
MemoryHigh=320M
CPUQuota=50%
CPUWeight=20
TasksMax=512
IOSchedulingClass=idle
Nice=10
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
