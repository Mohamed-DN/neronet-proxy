# NeroNet gateway node: settings the operator owns. Read by systemd (as root) and handed to
# the node; keep this file root:root 0600 anyway. Restart the node after a change:
#   systemctl restart neronet-gateway-node
#
# Do NOT put the fleet registration token here. A remote server enrols with a pre-auth key
# issued for this one node, placed in /var/lib/neronet-gateway/enrol.key (mode 0600, owned by
# neronet-gw). The node deletes that file once the control plane accepts it.

# The public address of the control plane. Must be https. It is reached over TLS verified
# against the CA below; there is no setting that skips verification.
#SOVEREIGN_CONTROL_PLANE_URL=https://console.example.org
#SOVEREIGN_CONTROL_PLANE_CA=/etc/neronet-gateway/control-ca.pem

# The TCP port the console tells devices to connect to: the port the other end sees, i.e. 443
# when this server's SNI router owns 443. Not the port Xray binds.
#SOVEREIGN_VLESS_PORT=443

# Where Xray binds. Loopback behind an SNI router; never the public address.
SOVEREIGN_VLESS_LISTEN=127.0.0.1:8445

# Read a PROXY protocol header from the router so that per-address limits see the real client.
# Only with the router sending it (nginx: proxy_protocol on) and only on a loopback listen.
#SOVEREIGN_VLESS_ACCEPT_PROXY=true

# A country you state yourself (ISO 3166-1 alpha-2). It is not measured. Leave unset if unsure.
#SOVEREIGN_COUNTRY_CODE=
