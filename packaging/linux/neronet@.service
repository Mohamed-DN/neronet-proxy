[Unit]
Description=NeroNet tunnel for profile %i
Documentation=file:///usr/share/doc/neronet/README.md
Wants=network-online.target
After=network-online.target systemd-resolved.service
# Profiles live in /etc/neronet/<name>.conf, mode 0600, owned by root.
ConditionPathExists=/etc/neronet/%i.conf
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# `neronet up` stays in the foreground and tears the tunnel down on SIGTERM.
ExecStart=/usr/bin/neronet up /etc/neronet/%i.conf --kill-switch
ExecStop=/usr/bin/neronet down
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Runs as root: the tunnel needs a TUN device, netlink and nftables.
# The bounding set keeps only what that takes; everything else is dropped.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
